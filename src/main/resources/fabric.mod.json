{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Server-side mod list check: kicks players whose client mods break the server's whitelist or banlist.",
  "authors": ["touchfalls"],
  "contributors": ["AVCD (original ModChecker)"],
  "contact": {
    "homepage": "https://modrinth.com/mod/modwarden-touchfalls",
    "sources": "https://github.com/touchfalls/modwarden",
    "issues": "https://github.com/touchfalls/modwarden/issues"
  },
  "license": "MIT",
  "icon": "assets/modwarden/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.touchfalls.modwarden.ModWarden"],
    "client": ["io.github.touchfalls.modwarden.client.ModWardenClient"]
  },
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "fabric-api": "*"
  }
}
